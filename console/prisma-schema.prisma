// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// saos-desk R338 — Sovereign Trading Boardroom persistence
model DeskBeat {
  id           Int      @id @default(autoincrement())
  seed         Int
  beat         Int
  symbol       String
  regime       String
  decision     String
  sizePct      Float
  confidence   Float
  quorumPassed Boolean
  riskPassed   Boolean
  realizedPct  Float
  sig          String   @unique
  artifact     String
  createdAt    DateTime @default(now())
}

model DeskWeight {
  agentId   String   @id
  weight    Float
  wins      Int      @default(0)
  losses    Int      @default(0)
  updatedAt DateTime @updatedAt
}

// saos-desk R346 — paper position lifecycle (the engine room)
// The LAW lives in repos/saos-desk/src/positions.mjs; this table is the book.
model DeskPosition {
  id            String   @id @default(cuid())
  symbol        String
  side          String
  sizePct       Float
  status        String   @default("OPEN")
  entryPrice    Float
  stopPrice     Float
  targetPrice   Float
  riskPerUnit   Float
  atrAtEntry    Float
  barsHeld      Int      @default(0)
  lastMarkT     Int      @default(0) // last marked daily-bar timestamp (mark at most once per trading day)
  lastMark      Float
  unrealizedPct Float    @default(0)
  exitPrice     Float?
  realizedPct   Float?
  closeReason   String?
  openedAt      DateTime @default(now())
  closedAt      DateTime?
  events        String   @default("[]") // append-only JSON event log
  sig           String   @unique // signature of the OPEN event payload (idempotency)
  updatedAt     DateTime @updatedAt
}